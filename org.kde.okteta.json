{
    "id": "org.kde.okteta",
    "runtime": "org.kde.Platform",
    "runtime-version": "5.15-25.08",
    "sdk": "org.kde.Sdk",
    "command": "okteta",
    "rename-icon": "okteta",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--socket=cups",
        "--socket=fallback-x11",
        "--socket=wayland"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/mkspecs",
        "/share/doc",
        "/share/man"
    ],
    "modules": [
        {
            "name": "qca",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTS=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/qca/2.3.12/qca-2.3.12.tar.xz",
                    "sha256": "d4a2b3aa0272d73ea0c4cd2140960177fa34ddc2030e59a48ecfb80c757572c3",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 13606,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/qca/$version/qca-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "okteta",
            "buildsystem": "cmake",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/okteta/0.26.27/src/okteta-0.26.27.tar.xz",
                    "sha256": "ef0209378df73b33ad87e5dd17137cad85e948c7c027bf40c327ed145c48cab8",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 229042,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/okteta/$version/src/okteta-$version.tar.xz"
                    }
                }
            ]
        }
    ]
}
